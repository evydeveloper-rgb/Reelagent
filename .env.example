# ---- Worker (.env.local, read by `npm run worker`) ----
CONVEX_URL=                 # written by `npx convex dev`
WORKER_SECRET=              # any long random string; set the SAME value in Convex env (below)
PHOTON_PROJECT_ID=          # pho_prj_... (Photon dashboard -> project Settings)
PHOTON_API_KEY=             # pho_sk_... project API key

# ---- Convex env (set with `npx convex env set NAME value`) ----
# WORKER_SECRET=                         same as above
# ANTHROPIC_API_KEY=                     storyboard + chat agent (Claude)
# FAL_KEY=                               AI clips (Kling) + generated images (Flux)
# ELEVENLABS_API_KEY=                    voiceover + word-synced captions (optional)
# ELEVENLABS_VOICE_ID=                   optional, defaults to "Rachel"
# FIRECRAWL_API_KEY=                     better website scraping: screenshot + brand colors + logo (optional)
# UPLOAD_POST_API_KEY=                   posting to Instagram, TikTok, LinkedIn, YouTube Shorts (upload-post.com)
# UPLOAD_POST_PROFILE_OVERRIDES=          optional: "<userId>=<profile>" pins a chat user to an existing Upload-Post profile
# FAL_VIDEO_MODEL=                       optional override, default fal-ai/kling-video/v2.1/standard/image-to-video
# FAL_IMAGE_MODEL=                       optional override, default fal-ai/flux-pro/v1.1
# MAX_AI_CLIPS=3                         AI clips per video (cost control)
